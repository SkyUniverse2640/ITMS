// NexusDesk / ITMS — PostgreSQL schema
//
// Every table, column, and relation the application uses is declared here.
// This file is the source of truth for the database structure.
//
// Conventions:
//   - Primary keys are UUID v7 (time-ordered, so "newest first" indexes stay tight).
//   - TypeScript sees camelCase; PostgreSQL sees snake_case via @map / @@map.
//   - Values the SuperAdmin can configure at runtime (ticket status, priority,
//     impact, urgency, asset state/type, request type) stay String — they are
//     driven by rows in `settings`, not by the schema.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums — only for value sets that are fixed in code, never admin-editable.
// ---------------------------------------------------------------------------

enum UserRole {
  SuperAdmin
  User

  @@map("user_role")
}

enum UserStatus {
  Active
  Inactive

  @@map("user_status")
}

enum AssetCategory {
  Hardware
  Software
  Consumable

  @@map("asset_category")
}

enum ApprovalStatus {
  Pending
  Approved
  Rejected

  @@map("approval_status")
}

enum AuditAction {
  Create
  Update
  Delete

  @@map("audit_action")
}

enum AuditModule {
  Ticket
  Asset
  User
  Task
  Purchase
  Settings

  @@map("audit_module")
}

enum ImportType {
  users
  assets
  departments

  @@map("import_type")
}

enum DashboardScope {
  system
  user

  @@map("dashboard_scope")
}

// ---------------------------------------------------------------------------
// People & places
// ---------------------------------------------------------------------------

model User {
  id       String @id @default(uuid(7))
  /// Human-facing name, shown throughout the UI.
  displayName String @map("display_name")
  /// Login handle. Stored lowercase; callers normalize before writing.
  username String @unique
  /// bcrypt hash, never the plaintext.
  password String
  role     UserRole   @default(User)
  /// Requester / Technician / Approver / Auditor — extensible via the
  /// `userTypes` setting, so this is a text array rather than an enum.
  userTypes String[]  @map("user_types")
  jobTitle  String?   @map("job_title")
  /// Department name, matched by name against the `departments` setting.
  department String?
  employeeId String   @unique @map("employee_id")
  mobile     String?
  email      String   @unique
  siteId     String?  @map("site_id")
  status     UserStatus @default(Active)
  lastLogin  DateTime?  @map("last_login")
  mustChangePassword Boolean @default(false) @map("must_change_password")
  /// Preferred dashboard: "general" | "admin" | a custom dashboard key.
  defaultDashboardKey String? @default("general") @map("default_dashboard_key")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  site Site? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  requestedTickets  Ticket[] @relation("TicketRequester")
  assignedTickets   Ticket[] @relation("TicketTechnician")
  approvingTickets  Ticket[] @relation("TicketApprover")
  ticketComments    TicketComment[]
  ticketLogs        TicketLog[]
  assignedAssets    Asset[]
  assignedTasks     Task[]   @relation("TaskAssignee")
  createdTasks      Task[]   @relation("TaskCreator")
  requestedPurchases Purchase[] @relation("PurchaseRequester")
  approvingPurchases Purchase[] @relation("PurchaseApprover")
  notifications     Notification[]
  auditLogs         AuditLog[]
  imports           ImportHistory[]
  dashboards        Dashboard[]

  @@index([role, status])
  @@map("users")
}

model Site {
  id        String   @id @default(uuid(7))
  name      String   @unique
  address   String?
  timezone  String   @default("Asia/Jakarta")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users  User[]
  assets Asset[]

  @@map("sites")
}

// ---------------------------------------------------------------------------
// Configuration
// ---------------------------------------------------------------------------

/// Key/value store for admin-configurable settings: ticket statuses, priorities,
/// departments, appearance, SMTP, onboarding state, and so on. `value` holds
/// arbitrary JSON whose shape depends on `key`.
model Settings {
  id        String   @id @default(uuid(7))
  key       String   @unique
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model Sla {
  id          String @id @default(uuid(7))
  name        String
  description String?
  /// Total resolution allowance, in minutes.
  duration    Int
  /// { days: number[], startHour: number, endHour: number }
  businessHours Json @map("business_hours")
  /// ISO date strings excluded from the SLA clock.
  holidays    String[]
  /// [{ percentage: number, notifyRoles: string[] }]
  escalation  Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tickets Ticket[]

  @@map("slas")
}

model Dashboard {
  id     String @id @default(uuid(7))
  /// Owner for custom dashboards; null for system dashboards.
  userId String? @map("user_id")
  /// Stable key: "general" | "admin" | a generated id.
  key    String  @unique
  name   String
  scope  DashboardScope @default(user)
  /// Who can see it: "all" | "superadmin" | a user type name.
  audience  String  @default("all")
  isDefault Boolean @default(false) @map("is_default")
  /// The built-in favorite (General), default for every user type.
  isSystemFavorite Boolean @default(false) @map("is_system_favorite")
  /// [{ id, type, title, dataSource, chartType?, filters?, position }]
  widgets   Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("dashboards")
}

model TicketTemplate {
  id           String  @id @default(uuid(7))
  name         String
  category     String
  subCategory  String? @map("sub_category")
  description  String?
  needApproval Boolean @default(false) @map("need_approval")
  /// Field values pre-filled on tickets created from this template.
  defaultFields Json   @default("{}") @map("default_fields")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("ticket_templates")
}

// ---------------------------------------------------------------------------
// Assets
// ---------------------------------------------------------------------------

model Asset {
  id            String  @id @default(uuid(7))
  name          String
  /// Type name from the `assetTypes` setting (Laptop, Monitor, …).
  assetType     String  @map("asset_type")
  assetCategory AssetCategory @map("asset_category")
  assetTag      String  @unique @map("asset_tag")
  serialNumber  String? @map("serial_number")
  vendor        String?
  purchaseCost  Float?  @map("purchase_cost")
  purchaseDate  DateTime? @map("purchase_date")
  expiredDate   DateTime? @map("expired_date")
  warrantyExpiredDate DateTime? @map("warranty_expired_date")
  /// State name from the `assetStates` setting.
  currentState  String  @default("In Warehouse") @map("current_state")
  assignedToId  String? @map("assigned_to_id")
  /// Denormalized from the assignee at assign time.
  department    String?
  siteId        String? @map("site_id")
  comment       String?
  // Software licensing
  licenseKey    String? @map("license_key")
  totalSeats    Int?    @map("total_seats")
  seatsUsed     Int?    @default(0) @map("seats_used")
  // Consumable stock
  stockQuantity     Int? @map("stock_quantity")
  reorderThreshold  Int? @map("reorder_threshold")
  unit              String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assignedTo User? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  site       Site? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  tickets   TicketAsset[]
  purchases Purchase[]

  @@index([assignedToId])
  @@index([currentState])
  @@index([assetCategory])
  @@map("assets")
}

// ---------------------------------------------------------------------------
// Tickets
// ---------------------------------------------------------------------------

model Ticket {
  id           String @id @default(uuid(7))
  /// {requestTypeCode}{YY}{MM}{seq}, e.g. INC2607001.
  ticketNumber String @unique @map("ticket_number")
  /// Name from the `requestTypes` setting.
  requestType  String @default("Incident") @map("request_type")
  /// Name from the `ticketStatuses` setting; transitions enforced in ticket-status.ts.
  status       String @default("Open")
  impact       String @default("Normal")
  urgency      String @default("Normal")
  /// Derived from impact × urgency via the `priorityMatrix` setting.
  priority     String @default("Normal")
  /// Legacy routing field, superseded by `department`. Kept for old tickets.
  group        String @default("IT")
  /// Handling department, matched by name against the `departments` setting.
  department   String? @default("IT")
  category     String?
  subCategory  String? @map("sub_category")
  project      String?

  requesterId    String @map("requester_id")
  /// Denormalized so the ticket list renders without a join.
  requesterName  String @map("requester_name")
  requesterEmail String @map("requester_email")
  technicianId   String? @map("technician_id")

  subject     String
  description String  @default("")
  attachments String[]

  approverId     String? @map("approver_id")
  /// Department hierarchy label used for approval (Director | Manager | Supervisor).
  approvalLabel  String? @map("approval_label")
  approvalStatus ApprovalStatus? @map("approval_status")

  closureCode     String?   @map("closure_code")
  resolutionNotes String?   @map("resolution_notes")
  resolvedAt      DateTime? @map("resolved_at")
  closedAt        DateTime? @map("closed_at")
  reopenedAt      DateTime? @map("reopened_at")

  // SLA is binary (OK / Breach); flags are recomputed from the due dates on read.
  slaBreached        Boolean   @default(false) @map("sla_breached")
  slaDueAt           DateTime? @map("sla_due_at")
  slaRespondDueAt    DateTime? @map("sla_respond_due_at")
  slaRespondBreached Boolean   @default(false) @map("sla_respond_breached")
  slaRespondedAt     DateTime? @map("sla_responded_at")
  slaConfigId        String?   @map("sla_config_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  requester  User  @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  technician User? @relation("TicketTechnician", fields: [technicianId], references: [id], onDelete: SetNull)
  approver   User? @relation("TicketApprover", fields: [approverId], references: [id], onDelete: SetNull)
  slaConfig  Sla?  @relation(fields: [slaConfigId], references: [id], onDelete: SetNull)

  comments      TicketComment[]
  logs          TicketLog[]
  relatedAssets TicketAsset[]
  tasks         Task[]

  @@index([requesterId])
  @@index([technicianId])
  @@index([approverId])
  @@index([status])
  @@index([priority])
  @@index([createdAt(sort: Desc)])
  @@map("tickets")
}

/// Was an embedded array on the ticket document; a table of its own so comments
/// can be filtered and counted across tickets.
model TicketComment {
  id          String   @id @default(uuid(7))
  ticketId    String   @map("ticket_id")
  authorId    String   @map("author_id")
  content     String
  /// Internal note — hidden from a plain requester.
  isPrivate   Boolean  @default(false) @map("is_private")
  attachments String[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@index([authorId])
  @@map("ticket_comments")
}

/// Activity trail shown on ticket detail → Logs. actorName / actorEmail are
/// denormalized so an entry stays readable even if the actor is removed.
model TicketLog {
  id         String  @id @default(uuid(7))
  ticketId   String  @map("ticket_id")
  actorId    String? @map("actor_id")
  actorName  String  @map("actor_name")
  actorEmail String? @map("actor_email")
  /// created | status_changed | technician_changed | approved | rejected
  action     String
  message    String
  fromStatus String? @map("from_status")
  toStatus   String? @map("to_status")
  createdAt  DateTime @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("ticket_logs")
}

/// Join table for Ticket ↔ Asset (was an array of loose ObjectIds).
model TicketAsset {
  ticketId String @map("ticket_id")
  assetId  String @map("asset_id")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  asset  Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([ticketId, assetId])
  @@index([assetId])
  @@map("ticket_assets")
}

// ---------------------------------------------------------------------------
// Tasks & purchases
// ---------------------------------------------------------------------------

model Task {
  id             String  @id @default(uuid(7))
  title          String
  description    String?
  relatedTicketId String? @map("related_ticket_id")
  assigneeId     String  @map("assignee_id")
  dateStart      DateTime? @map("date_start")
  dateEnd        DateTime? @map("date_end")
  dueDate        DateTime? @map("due_date")
  /// "To Do" | "In Progress" | "Done" — the labels the UI sends verbatim.
  status         String  @default("To Do")
  priority       String  @default("Normal")
  /// [{ item: string, done: boolean }]
  checklist      Json    @default("[]")
  createdById    String  @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  relatedTicket Ticket? @relation(fields: [relatedTicketId], references: [id], onDelete: SetNull)
  assignee      User    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdBy     User    @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([assigneeId, status])
  @@index([relatedTicketId])
  @@map("tasks")
}

model Purchase {
  id              String  @id @default(uuid(7))
  itemName        String  @map("item_name")
  /// Asset type to create when the purchase is completed.
  linkedAssetType String? @map("linked_asset_type")
  quantity        Int
  estimatedCost   Float   @map("estimated_cost")
  vendor          String?
  justification   String?
  requestedById   String  @map("requested_by_id")
  approverId      String? @map("approver_id")
  /// "Draft" | "Pending Approval" | "Approved" | "Rejected" | "Completed"
  status          String  @default("Draft")
  rejectionReason String? @map("rejection_reason")
  /// Asset created on completion.
  linkedAssetId   String? @map("linked_asset_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  requestedBy User   @relation("PurchaseRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approver    User?  @relation("PurchaseApprover", fields: [approverId], references: [id], onDelete: SetNull)
  linkedAsset Asset? @relation(fields: [linkedAssetId], references: [id], onDelete: SetNull)

  @@index([requestedById])
  @@index([approverId, status])
  @@index([status])
  @@map("purchases")
}

// ---------------------------------------------------------------------------
// Notifications, audit, imports
// ---------------------------------------------------------------------------

model Notification {
  id          String   @id @default(uuid(7))
  recipientId String   @map("recipient_id")
  title       String
  message     String
  /// ticket_created | ticket_assigned | status_changed | comment_added | …
  type        String
  link        String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, read, createdAt(sort: Desc)])
  @@map("notifications")
}

model AuditLog {
  id          String  @id @default(uuid(7))
  actorId     String  @map("actor_id")
  actorName   String  @map("actor_name")
  action      AuditAction
  module      AuditModule
  /// Id of the affected record, or a marker like "import" / a setting key.
  targetId    String  @map("target_id")
  targetLabel String  @map("target_label")
  /// Field snapshots; shape depends on the module.
  before      Json?
  after       Json?
  ipAddress   String? @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt(sort: Desc)])
  @@index([module, action])
  @@index([actorId])
  @@map("audit_logs")
}

model ImportHistory {
  id             String  @id @default(uuid(7))
  type           ImportType
  fileName       String  @map("file_name")
  importedById   String? @map("imported_by_id")
  importedByName String  @map("imported_by_name")
  /// { total, created, updated, failed }
  summary        Json
  /// [{ row, data?, error }]
  failures       Json    @default("[]")
  /// Per-row outcome: [{ row, status, error?, key? }]
  results        Json    @default("[]")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  importedBy User? @relation(fields: [importedById], references: [id], onDelete: SetNull)

  @@index([type, createdAt(sort: Desc)])
  @@map("import_history")
}
